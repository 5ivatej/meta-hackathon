PORT=7860
HF_HOME=/root/.cache/huggingface

EXAMPLES_SOURCE=esconv_hf
DATASET_NAME=thu-coai/esconv
DATASET_SPLIT=train
MAX_SEED_EXAMPLES=200

POLICY_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
USER_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
CRITIC_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

SIM_OUTPUT_DIR=artifacts/sim_data
SIM_EPISODES_PER_SEED=2
SIM_NUM_CANDIDATES=4
SIM_ROLLOUT_STEPS=6
SIM_MAX_TURNS=16

REWARD_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
REWARD_MODEL_OUTPUT_DIR=artifacts/reward_model

GRPO_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
GRPO_OUTPUT_DIR=artifacts/grpo_policy
